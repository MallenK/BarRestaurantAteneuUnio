# Clau secreta de AddToWallet (Dashboard -> API Keys). Mai la publiquis al frontend.
ADDTOWALLET_API_KEY=tu_api_key_aqui

# Nom mostrat a la targeta i als missatges d'error
RESTAURANT_NAME="Ateneu Unió"

# URL pública del logo (quadrat) que es mostra a la targeta
WALLET_LOGO_URL=https://ateneuuniorestaurant.com/assets/img/favicon-512.png

# Clau alternativa per a integracions màquina-a-màquina (capçalera x-staff-key
# a POST /api/wallet/stamp i GET /api/wallet/cards). El panell /admin ja NO
# fa servir aquesta clau: hi entres amb un compte real (Better Auth, veure sota).
# Genera'n una amb: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STAFF_API_KEY=canvia_aquesta_clau

# --- Better Auth (login del panell /admin) ---
# Secret de signatura de sessions/cookies. Genera'l amb:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=canvia_aquest_secret
# URL pública on viu aquest backend (mateix origen que serveix /admin i /api)
BETTER_AUTH_URL=http://localhost:3000

# Orígens permesos (CORS), separats per comes
ALLOWED_ORIGINS=https://ateneuuniorestaurant.com,https://mallenk.github.io

# Port on escolta el servidor
PORT=3000

# Nombre de segells necessaris per aconseguir el premi
STAMPS_TO_REWARD=10
